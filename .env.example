# Ekip Takvim settings. Copy to .env and fill in the four values under
# "Required". Every setting is described in docs/configuration.md.
# Docker Compose and `npm run dev` both read this file.

# ── Required ─────────────────────────────────────────────────────
# The OAuth client from Google Cloud (docs/google-setup.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 or more random characters, e.g. the output of `openssl rand -base64 32`.
# It signs sessions and encrypts the stored Google access. Keep a copy
# somewhere safe; changing or losing it signs everyone out.
SESSION_SECRET=

# The address people open the app at, e.g. https://calendar.example.com.
# Google sends people back to APP_URL/auth/google/callback, so that exact
# address must be listed in the OAuth client.
APP_URL=

# ── Optional ─────────────────────────────────────────────────────
# The team's time zone, if config/app.yaml doesn't set one. Without either
# it's UTC in Docker, or your computer's zone with `npm run dev`.
# TZ=Europe/Istanbul

# Cloudflare Access check: only requests that came through Access for this
# app get in. Set both or neither (docs/access-control.md).
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=

# HTTP basic auth on everything except /healthz and the icons, for when the
# app can't sit behind a VPN or an access proxy. Set both or neither.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# The whole YAML config inline, instead of config/app.yaml.
# CONFIG_YAML=
